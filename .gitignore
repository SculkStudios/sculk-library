secrets/
credentials/
application-secrets.yml
application-secrets.yaml

# Local databases
*.db
*.sqlite
*.sqlite3
*.h2.db
*.mv.db
*.trace.db

# Local test servers. Anchored to the root: an unanchored `world/` or `plugins/` would also hide
# source packages and modules such as sculk-world. Integration-test servers live under build/.
/server/
/test-server/
/run/
/runs/

# Generated documentation / docs runtime
.dokka/
/site/
docs/.astro/
docs/dist/
docs/node_modules/

# Temporary files
/tmp/
/temp/
*.tmp
*.temp
*.bak
*.swp
*.swo

# Archives / packaged outputs
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Node tooling if docs site uses Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Maven local release artifacts
release/
staging/

# JMH results
benchmarks/results/

# Local test server created by `gradlew runServer`
examples/*/run/

# Claude Code session data and agent worktrees
/.claude/
