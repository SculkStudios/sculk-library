.gradle-cache/
gradle-app.setting

# Kotlin / Java
.kotlin/
bin/
**/bin/
out/
target/
*.class
*.jar
*.war
*.ear
*.nar

# Do not ignore Gradle wrapper files
!gradlew
!gradlew.bat
!gradle/wrapper/gradle-wrapper.properties
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Keep shared IntelliJ code style if the project intentionally uses it
!.idea/codeStyles/
!.idea/codeStyles/*
!.idea/inspectionProfiles/
!.idea/inspectionProfiles/*

# Eclipse
.project
.classpath
.settings/

# VS Code
.vscode/
*.code-workspace
!.vscode/extensions.json
!.vscode/settings.example.json

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Logs / JVM crash output
/logs/
*.log
*.log.*
hs_err_pid*
replay_pid*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
