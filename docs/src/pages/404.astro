---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import { navigation } from '../lib/nav';

const sections = navigation(await getCollection('docs'));
---
<Site title="Page not found · Sculk Studio" description="This page does not exist in the Sculk Studio documentation." sections={sections}>
	<article>
		<h1 class="page-title">This page does not exist</h1>
		<div class="prose">
			<p>The link may be from the 5.x documentation, or the page may have moved. Search with <span class="kbd">Ctrl K</span>, or start from one of these:</p>
			<ul>
				<li><a href="/">The documentation home</a></li>
				<li><a href="/start/installation/">Install on Paper and Folia</a></li>
				<li><a href="/reference/roadmap/">The roadmap</a></li>
			</ul>
		</div>
	</article>
</Site>
