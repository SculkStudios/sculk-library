---
import { getCollection } from 'astro:content';
import { Code } from 'astro-expressive-code/components';
import Site from '../layouts/Site.astro';
import { navigation } from '../lib/nav';
import { moduleStatus, readRepoDoc, tablesOf } from '../lib/repo-tables';

const sections = navigation(await getCollection('docs'));

// The status line reads MODULES.md at build time, so it cannot claim more than the repository does.
const modules = tablesOf(readRepoDoc('MODULES.md'))
	.filter((table) => table.columns[0] === 'Module' && table.columns.at(-1) === 'Status')
	.flatMap((table) => table.rows.map((row) => moduleStatus(row.at(-1) ?? '')));
const done = modules.filter((status) => status === 'done').length;

const sample = `class MyPlugin : SculkPaperPlugin() {
    override suspend fun start() {
        sculk.events.observe<PlayerJoinEvent> { event -> greet(event.player) }
    }

    private suspend fun greet(player: Player) {
        val visits = withAsync { readVisits(player.uniqueId) }
        val greeted = withEntity(player) {
            player.send("Welcome back, visit <visits>.", "visits" to visits)
        }
        if (greeted is EntityResult.Gone) logger.info("\${player.name} left")
    }
}`;

const features = [
	{ href: '/guides/commands/', title: 'Commands', text: "One typed command DSL, compiled into each platform's own Brigadier tree." },
	{ href: '/guides/menus/', title: 'GUIs and menus', text: 'Inventory menus drawn from their state, redrawn slot by slot and locked against item theft.' },
	{ href: '/guides/dialogs/', title: 'Dialogs', text: 'Forms with checked, typed answers on Paper 1.21.7 and later, and a fallback before that.' },
	{ href: '/guides/hud/', title: 'Scoreboards and HUD', text: 'Sidebars, boss bars, action bars and tab lists that redraw only what changed.' },
	{ href: '/guides/config/', title: 'Configs', text: "Typed YAML files that keep operators' comments and reload transactionally." },
	{ href: '/guides/text/', title: 'Text and MiniMessage', text: 'MiniMessage rendering where templates are trusted and player values never parse as tags.' },
	{ href: '/guides/placeholders/', title: 'Placeholders', text: 'Typed global, per-player and relational placeholders, as MiniMessage tags.' },
	{ href: '/guides/items/', title: 'Items', text: 'Item specs compiled to data components on every supported Paper version.' },
];
---
<Site title="Sculk Studio: the Kotlin platform for Minecraft server plugins" description="Write a Minecraft server plugin once in Kotlin and run it on Paper, Folia, Canvas and Velocity, with every task on the thread that owns what it touches." sections={sections}>
	<article data-pagefind-body data-pagefind-meta="section:Home">
		<h1 class="page-title home-title">The Kotlin platform for Paper, Folia, Canvas and Velocity plugins.</h1>
		<p class="lede">Write the plugin once in Kotlin. It runs on Paper, Folia, Canvas and Velocity, and every task runs on the thread that owns what it touches, whether that is the main thread on Paper or a region on Folia.</p>
		<div class="actions">
			<a class="primary" href="/start/installation/">Install Sculk</a>
			<a href="/start/why-sculk/">Why Sculk</a>
			<a href="/start/examples/">See the examples</a>
		</div>

		<div class="prose">
			<Code code={sample} lang="kotlin" title="MyPlugin.kt" />
			<p>The observer resumes on the player's own thread. <code>withAsync</code> runs the read off every game thread, and <code>withEntity</code> returns <code>Gone</code> if the player left in the meantime. <code>send</code> renders MiniMessage with <code>visits</code> as a placeholder, so a value can never inject tags. On Paper all of it is the main thread; on Folia and Canvas it is the player's region, and the code does not change.</p>

			<h2 id="build">What you can build</h2>
			<div class="features">
				{features.map((feature) => <a class="feature" href={feature.href}><b>{feature.title}</b><span>{feature.text}</span></a>)}
			</div>

			<p class="status">Sculk 6 is not released yet: <span class="num">{done}</span> of <span class="num">{modules.length}</span> modules are done. The <a href="/reference/roadmap/">roadmap</a> lists every module and where it stands.</p>
		</div>
	</article>
	<Fragment slot="margin">
		<section>
			<p class="label">Status</p>
			<p class="note">Sculk 6 is a ground-up rewrite on the <code>dev</code> branch and is <strong>not released</strong>. Build it yourself with <code>publishToMavenLocal</code>; only modules marked done exist today.</p>
		</section>
		<section>
			<p class="label">Start here</p>
			<nav class="toc" aria-label="Start here">
				<a href="/start/installation/">Install Sculk</a>
				<a href="/start/first-plugin/">Your first plugin</a>
				<a href="/concepts/execution/">Threading</a>
				<a href="/concepts/testing/">Testing</a>
				<a href="/reference/compatibility/">Compatibility</a>
			</nav>
		</section>
	</Fragment>
</Site>

<style>
	.home-title { font-size: clamp(32px, 3.2vw, 44px); line-height: 1.12; max-width: 24ch; margin: 8px 0 0; }
	.actions { display: flex; flex-wrap: wrap; gap: 10px 22px; align-items: center; margin: 28px 0 36px; font-size: 15px; }
	.actions a { color: var(--text-2); text-decoration: underline; text-decoration-color: var(--rule-strong); text-underline-offset: 5px; }
	.actions a:hover { color: var(--text); text-decoration-color: var(--text); }
	.actions .primary { display: inline-flex; align-items: center; height: 44px; padding: 0 20px; border-radius: 8px; background: #ededed; color: #000; font-weight: 600; text-decoration: none; transition: background-color 160ms var(--ease); }
	.actions .primary:hover { background: #fff; color: #000; }
	.prose { margin-top: 0; }
	.features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 18px; }
	.prose .feature { display: block; padding: 16px 18px; border: 1px solid var(--rule-strong); border-radius: 10px; text-decoration: none; transition: border-color 160ms var(--ease), background-color 160ms var(--ease); }
	.prose .feature:hover { border-color: #4a4a4a; background: var(--raised); }
	.feature b { display: block; font-family: var(--display); font-weight: 600; font-size: 15.5px; color: #fff; }
	.feature span { display: block; margin-top: 4px; font-size: 14px; line-height: 1.55; color: var(--text-2); }
	.prose .status { margin-top: 32px; color: var(--text-2); }
	@media (max-width: 600px) { .features { grid-template-columns: minmax(0, 1fr); } }
	.note { font-size: 14px; line-height: 1.6; color: var(--text-2); }
	.note code { font-family: var(--mono); font-size: 12.5px; }
	.note strong { color: var(--text); }
</style>
