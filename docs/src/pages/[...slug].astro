---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Support from '../components/Support.astro';
import Toc from '../components/Toc.astro';
import WhereItRuns from '../components/WhereItRuns.astro';
import Site from '../layouts/Site.astro';
import { navigation, neighbours, sectionOf } from '../lib/nav';

export async function getStaticPaths() {
	const entries = await getCollection('docs', (entry) => !entry.data.draft);
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
	entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const sections = navigation(await getCollection('docs'));
const { Content, headings } = await render(entry);
const { previous, next } = neighbours(sections, entry.id);
const section = sectionOf(entry.id);
const editUrl = `https://github.com/SculkStudios/sculk-library/edit/dev/docs/src/content/docs/${entry.id}.mdx`;
const { title, description, module, since, runs, support } = entry.data;
---
<Site title={title} description={description} sections={sections} current={entry.id}>
	<article data-pagefind-body>
		<nav aria-label="Breadcrumb"><ol class="crumbs">{section && <li>{section}</li>}<li aria-current="page">{title}</li></ol></nav>
		<h1 class="page-title">{title}</h1>
		<div class="meta" data-pagefind-ignore>
			{since && <span>Since <span class="num">{since}</span></span>}
			{module && <span>Module <span class="num">{module}</span></span>}
			<a href={editUrl}>Edit on GitHub</a>
			<button class="copy-page" type="button" data-source={`# ${title}\n\n${entry.body ?? ''}`}><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect><path d="M10.5 5.5V3.75A1.25 1.25 0 009.25 2.5h-5.5A1.25 1.25 0 002.5 3.75v5.5a1.25 1.25 0 001.25 1.25H5.5"></path></svg><span>Copy page</span></button>
		</div>
		<div class="prose">
			<Content />
		</div>
	</article>
	<nav class="foot" aria-label="Previous and next" data-pagefind-ignore>
		{previous && <a href={previous.href} rel="prev"><small>Previous</small><span>{previous.label}</span></a>}
		{next && <a class="next" href={next.href} rel="next"><small>Next</small><span>{next.label}</span></a>}
	</nav>
	<p class="colophon">Sculk Studio is not an official Minecraft product and is not approved by or associated with Mojang or Microsoft.</p>
	<Fragment slot="margin">
		{runs && <section><p class="label">Where it runs</p><WhereItRuns runs={runs} /></section>}
		{support && <section><p class="label">Support</p><Support support={support} /></section>}
		<section><Toc headings={headings} /></section>
	</Fragment>
</Site>
<script>
	// Copies the page as Markdown, for pasting into an issue or an assistant.
	for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-page')) {
		button.addEventListener('click', async () => {
			const label = button.querySelector('span');
			try {
				await navigator.clipboard.writeText(button.dataset.source ?? '');
				if (label) label.textContent = 'Copied';
			} catch {
				if (label) label.textContent = 'Copy failed';
			}
			setTimeout(() => { if (label) label.textContent = 'Copy page'; }, 1600);
		});
	}
</script>
