---
// The navigation by category; a page marks itself only when the chosen platform supports it in part or not at all.
import { PLATFORMS, PLATFORM_LABELS, type NavSection } from '../lib/nav';

const icons: Record<string, string> = {
	book: '<path d="M2 3.5h4A2 2 0 0 1 8 5.5V13a1.5 1.5 0 0 0-1.5-1.5H2zM14 3.5h-4A2 2 0 0 0 8 5.5V13a1.5 1.5 0 0 1 1.5-1.5H14z"/>',
	server: '<rect x="2.5" y="2.5" width="11" height="4.5" rx="1"/><rect x="2.5" y="9" width="11" height="4.5" rx="1"/><path d="M5 4.75h.01M5 11.25h.01"/>',
	layers: '<path d="M8 2l6 3-6 3-6-3zM2 8l6 3 6-3M2 11l6 3 6-3"/>',
	terminal: '<rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M5 6.5l2 1.5-2 1.5M8.5 10H11"/>',
	message: '<path d="M2.5 3.5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H6l-3.5 2.5z"/>',
	window: '<rect x="2" y="2.5" width="12" height="11" rx="1.5"/><path d="M2 6h12M6.5 6v7.5"/>',
	cube: '<path d="M8 1.8l5.5 3v6.4L8 14.2l-5.5-3V4.8zM2.5 4.8L8 7.8l5.5-3M8 7.8v6.4"/>',
	file: '<path d="M4 1.8h5.5l3 3v9.4H4zM9.5 1.8v3h3M6 8.5h4.5M6 11h4.5"/>',
};

interface Props {
	sections: NavSection[];
	current?: string;
}

const { sections, current } = Astro.props;
---
<nav class="legend" id="legend" aria-label="Documentation" data-pagefind-ignore>
	{sections.map((section) => (
		<>
			<p class="group"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[section.icon]}></svg>{section.label}</p>
			<ul>
				{section.items.map((item) => (
					<li>
						<a href={item.href} aria-current={item.id === current ? 'page' : undefined}>
							{item.label}
							{item.support && PLATFORMS.map((platform) => {
								const level = item.support?.[platform];
								return level === 'partial' || level === 'none' ? (
									<span class="nav-tag" data-platform={platform} title={`${level === 'partial' ? 'Partly supported' : 'Not supported'} on ${PLATFORM_LABELS[platform]}`}>{level === 'partial' ? 'Partial' : 'Unsupported'}</span>
								) : null;
							})}
						</a>
					</li>
				))}
			</ul>
		</>
	))}
</nav>
