---
// The navigation, set as a map legend: each page carries its support mark for the chosen platform,
// and the page you are on is pinned.
import Mark from './Mark.astro';
import { PLATFORMS, type NavSection } from '../lib/nav';

interface Props {
	sections: NavSection[];
	current?: string;
}

const { sections, current } = Astro.props;
---
<nav class="legend" id="legend" aria-label="Documentation" data-pagefind-ignore>
	{sections.map((section) => (
		<>
			<p class="group">{section.label}</p>
			<ul>
				{section.items.map((item) => (
					<li>
						<a href={item.href} aria-current={item.id === current ? 'page' : undefined}>
							{item.id === current ? (
								<svg class="pin" width="10" height="13" viewBox="0 0 10 13" aria-hidden="true"><path d="M5 12.5S.75 7.6.75 4.75a4.25 4.25 0 018.5 0C9.25 7.6 5 12.5 5 12.5z" fill="#f0954f"></path><circle cx="5" cy="4.75" r="1.6" fill="#0a0c0d"></circle></svg>
							) : item.support ? (
								<span class="nav-mark">{PLATFORMS.map((platform) => <Mark level={item.support?.[platform] ?? 'full'} platform={platform} />)}</span>
							) : (
								<span class="mark-unknown" aria-hidden="true"></span>
							)}
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</>
	))}
</nav>
