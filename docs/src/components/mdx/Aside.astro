---
// A calm note: neutral fill and a glyph; only danger takes a coloured edge.
interface Props {
	type?: 'note' | 'tip' | 'caution' | 'danger';
	title?: string;
}

const { type = 'note', title } = Astro.props;
const titles = { note: 'Note', tip: 'Tip', caution: 'Caution', danger: 'Danger' };
---
<aside class="aside" data-type={type} aria-label={title ?? titles[type]}>
	<p class="aside-title">
		{type === 'note' && <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path d="M7 6v4M7 3.8v.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>}
		{type === 'tip' && <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1.5l1.6 3.6 3.9.4-2.9 2.6.8 3.9L7 10l-3.4 2 .8-3.9L1.5 5.5l3.9-.4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>}
		{type === 'caution' && <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1.5l6 11H1z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path><path d="M7 6v3M7 10.6v.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>}
		{type === 'danger' && <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="1.5" y="1.5" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M4.5 4.5l5 5M9.5 4.5l-5 5" stroke="currentColor" stroke-width="1.4"></path></svg>}
		{title ?? titles[type]}
	</p>
	<div><slot /></div>
</aside>
