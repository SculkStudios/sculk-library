---
import { PLATFORMS, PLATFORM_LABELS } from '../lib/nav';
---
<header class="mast">
	<a class="brand" href="/" aria-label="Sculk Studio documentation home">
		<svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
			<rect x="0.75" y="0.75" width="24.5" height="24.5" fill="none" stroke="#ffffff" stroke-width="1.5"></rect>
			<path d="M9 1v24M17 1v24M1 9h24M1 17h24" stroke="#ffffff" stroke-opacity=".35" stroke-width="1"></path>
			<rect x="9.5" y="9.5" width="7" height="7" fill="#cba6f7"></rect>
		</svg>
		<b>Sculk Studio</b>
	</a>
	<button class="search-open" type="button" data-search-open aria-haspopup="dialog">
		<svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
		<span>Search<span class="hint"> guides, APIs and config keys</span></span>
		<kbd>Ctrl K</kbd>
	</button>
	<div class="chart">
		<label class="select">
			<span>Platform</span>
			<select data-platform-select aria-label="Show support for platform">
				{PLATFORMS.map((platform) => <option value={platform}>{PLATFORM_LABELS[platform]}</option>)}
			</select>
			<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
		</label>
		<span class="select version" title="Sculk 6, for Paper 1.21.4 to 26.3, Folia and Canvas 26.3, Velocity 4.3"><span>Version</span> <span class="num" style="color:var(--text);font-weight:600">6.0</span></span>
		<button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="legend" aria-label="Open the contents">
			<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5"></path></svg>
		</button>
	</div>
</header>
