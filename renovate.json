{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:kotlinx-coroutinesMonorepo",
    "group:junit-frameworkMonorepo"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "automerge": false,
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "groupName": "Kotlin toolchain",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin:/",
        "/^org\\.jetbrains\\.kotlin\\./",
        "/^com\\.google\\.devtools\\.ksp/",
        "/^org\\.jetbrains\\.dokka/"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "The Adventure floor is the oldest version Paper 1.21.4 ships and is pinned deliberately; the 5.x test target updates normally.",
      "matchPackageNames": [
        "/^net\\.kyori:adventure-/"
      ],
      "matchCurrentVersion": "/^4\\./",
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Anchor builds are pinned deliberately; COMPATIBILITY.md moves with them.",
      "matchPackageNames": [
        "io.papermc.paper:paper-api",
        "io.canvasmc.canvas:canvas-api"
      ],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "schedule": [
        "before 6am on monday"
      ],
      "minimumReleaseAge": "7 days"
    }
  ]
}
